<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="adminmaster.Master.cs" Inherits="CTechGrowthSolutions.adminmaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="css/bootstrap.min.css" rel="stylesheet" />
      <style>
    body {
      background: #f4f6f9;
    }
    .sidebar {
      min-height: 100vh;
      background: #34495e;
    }
    .sidebar .nav-link {
      color: #fff;
    }
    .sidebar .nav-link:hover {
      background: #1abc9c;
      color: #fff;
    }
    footer {
      background: #2c3e50;
      color: #fff;
      text-align: center;
      padding: 10px;
    }
  </style>
    <script>
        window.history.pushState(null, "", window.location.href);
        window.onpopstate = function () {
            window.location.href = "adminLogin.aspx";
        };
</script>

</head>
<body  >
 
    <form id="form1" runat="server">
        <asp:ScriptManager ID="sc" runat="server"></asp:ScriptManager>
    <div>
         <header class="bg-dark text-white p-3 text-center">
    <h1>Admin Dashboard</h1>
  </header>

  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse" id="sidebarMenu">
        <div class="position-sticky pt-3">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="Adminhome.aspx">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="collapse" href="#usersSubmenu" role="button">
                Student Operation
              </a>
              <div class="collapse" id="usersSubmenu">
                <ul class="nav flex-column ms-3">
                  <li class="nav-item"><a class="nav-link" href="StudReg.aspx">Registration</a></li>
                    <li class="nav-item"><a class="nav-link" href="AddCourse.aspx">Course Registraion</a></li>
                      <li class="nav-item"><a class="nav-link" href="CourseOperation.aspx">Course Operation</a></li>
                  <%--<li class="nav-item"><a class="nav-link" href="#">Manage Users</a></li>--%>
                </ul>
              </div>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="collapse" href="#reportsSubmenu" role="button">
                Reports
              </a>
              <div class="collapse" id="reportsSubmenu">
                <ul class="nav flex-column ms-3">
                  <li class="nav-item"><a class="nav-link" href="#">Sales Report</a></li>
                  <li class="nav-item"><a class="nav-link" href="#">Activity Report</a></li>
                </ul>
              </div>
            </li>
            <li class="nav-item"><a class="nav-link" href="#">Settings</a></li>
            <li class="nav-item"><%--<a class="nav-link" href="#">Logout</a>--%>

                <asp:LinkButton ID="lnklogout" runat="server" CssClass="nav-link" OnClick="lnklogout_Click" Text="Logout"></asp:LinkButton>

            </li>
          </ul>
        </div>
      </nav>

      <!-- Main Content -->
         <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
        </asp:ContentPlaceHolder>
     
    </div>
  </div>
       

         <footer>
    &copy; 2026 Admin Panel | Designed by Bhavesh
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </div>
    </form>
</body>
</html>
